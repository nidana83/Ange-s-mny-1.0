# Port de l'API locale (liée à 127.0.0.1 uniquement)
PORT=4310
# Chemin de la base SQLite
DB_PATH=./data/anges-mny.db
# Clé de chiffrement (32 octets en hex) pour les jetons de session bancaire.
# Si absente, une clé est générée dans data/secret.key au premier lancement.
# MNY_SECRET_KEY=

# --- Connexion Open Banking (Enable Banking — agrégateur PSD2 agréé) ---
# Créez une application sur https://enablebanking.com/cp/applications
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_KEY_PATH=./data/enablebanking.pem
# ENABLE_BANKING_REDIRECT_URL=http://localhost:5173/api/bank/callback
# Pays de votre banque (code ISO), Revolut est enregistré par pays
# ENABLE_BANKING_COUNTRY=FR

# Intervalle de synchronisation automatique en heures (PSD2 : 4 accès/jour max sans action de l'utilisateur)
SYNC_INTERVAL_HOURS=6

# Mettre à true derrière HTTPS (cookie de session « Secure » + HSTS)
COOKIE_SECURE=false
# Écoute réseau : 127.0.0.1 par défaut. 0.0.0.0 uniquement derrière un reverse proxy HTTPS.
HOST=127.0.0.1
# Sauvegardes automatiques quotidiennes
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
